<?xml version="1.0" ?>

<resources xmlns="https://api-platform.com/schema/metadata"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="https://api-platform.com/schema/metadata https://api-platform.com/schema/metadata/metadata-2.0.xsd"
>
    <resource class="%dedi_sylius_seo_plugin.model.seo_content_translation.class%" shortName="SEOContentTranslation">
        <collectionOperations />
        <itemOperations>
            <itemOperation name="admin_get">
                <attribute name="method">GET</attribute>
                <attribute name="path">/admin/seo-content-translations/{id}</attribute>
                <attribute name="normalization_context">
                    <attribute name="groups">
                        <attribute>sylius:admin:seo_content:show</attribute>
                    </attribute>
                </attribute>
            </itemOperation>
            <itemOperation name="shop_get">
                <attribute name="method">GET</attribute>
                <attribute name="path">/shop/seo-content-translations/{id}</attribute>
                <attribute name="normalization_context">
                    <attribute name="groups">
                        <attribute>sylius:shop:seo_content:show</attribute>
                    </attribute>
                </attribute>
            </itemOperation>
        </itemOperations>

        <property name="id" identifier="true" writable="false" />
        <property name="locale" required="true" />
        <property name="notIndexable" required="false" />
        <property name="metadataTitle" required="false" />
        <property name="metadataDescription" required="false" />
        <property name="openGraphMetadataTitle" required="false" />
        <property name="openGraphMetadataDescription" required="false" />
        <property name="openGraphMetadataUrl" required="false" />
        <property name="openGraphMetadataImage" required="false" />
        <property name="openGraphMetadataType" required="false" />
    </resource>
</resources>
